<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Parallel execution requires at least as many Android devices as the
    thread-count below. Register them in devices/devices.json.
-->
<suite name="Android Parallel Suite" verbose="1" parallel="methods" thread-count="2">

    <listeners>
        <listener class-name="com.enterprise.mobile.listeners.TestListener"/>
        <listener class-name="com.enterprise.mobile.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="Android Parallel Launch">
        <classes>
            <class name="com.enterprise.mobile.bdd.runner.CucumberParallelTestNG"/>
        </classes>
    </test>

</suite>
